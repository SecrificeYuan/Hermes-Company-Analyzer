{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/contracts/visualization-spec.v1.schema.json",
  "title": "VisualizationSpec v1", "x-contract-status": "frozen", "type": "object", "additionalProperties": false,
  "required": ["id", "dimension", "chartType", "title", "description", "metricSeriesIds", "eventIds", "evidenceIds", "timeRange", "emptyState"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "dimension": { "type": "string", "enum": ["financial_health", "debt_credit", "operations_reputation"] },
    "chartType": { "type": "string", "enum": ["line", "bar", "stacked_bar", "area", "radar", "timeline", "table"] }, "title": { "type": "string" }, "description": { "type": "string" },
    "metricSeriesIds": { "type": "array", "items": { "type": "string" } }, "eventIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "timeRange": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "string" }, "end": { "type": "string" } } },
    "emptyState": { "type": "object", "additionalProperties": false, "required": ["isEmpty", "message"], "properties": { "isEmpty": { "type": "boolean" }, "message": { "type": "string" } } }
  }
}
