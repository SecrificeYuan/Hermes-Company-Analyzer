{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/contracts/company-snapshot.v1.schema.json",
  "title": "CompanySnapshot v1",
  "x-contract-status": "frozen",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "collectedAt", "company", "financialSeries", "events", "observations", "evidence", "coverage", "collectionErrors", "normalizationDecisions"],
  "properties": {
    "schemaVersion": { "const": "v1" }, "snapshotId": { "type": "string" }, "collectedAt": { "type": "string", "format": "date-time" },
    "company": { "$ref": "#/$defs/company" }, "financialSeries": { "type": "array", "items": { "$ref": "#/$defs/metricSeries" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }, "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "coverage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/coverage" } },
    "collectionErrors": { "type": "array", "items": { "$ref": "#/$defs/error" } }, "normalizationDecisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "company": { "type": "object", "additionalProperties": false, "required": ["name", "stockCode", "market"], "properties": { "name": { "type": "string" }, "stockCode": { "type": "string", "pattern": "^\\d{6}$" }, "market": { "const": "A_SHARE" }, "industry": { "type": "string" } } },
    "metricSeries": { "type": "object", "additionalProperties": false, "required": ["id", "label", "unit", "points"], "properties": { "id": { "type": "string", "enum": ["revenue", "net_profit", "operating_cash_flow", "total_assets", "total_liabilities", "current_assets", "current_liabilities", "receivables"] }, "label": { "type": "string" }, "unit": { "type": "string", "enum": ["CNY", "percent", "ratio"] }, "points": { "type": "array", "items": { "$ref": "#/$defs/point" } } } },
    "point": { "type": "object", "additionalProperties": false, "required": ["period", "value", "evidenceIds", "dataQuality"], "properties": { "period": { "type": "string", "pattern": "^\\d{4}(FY|Q[1-4])$" }, "value": { "type": "number" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "dataQuality": { "$ref": "#/$defs/dataQuality" } } },
    "event": { "type": "object", "additionalProperties": false, "required": ["id", "category", "claimKind", "occurredAt", "title", "summary", "evidenceIds", "dataQuality"], "properties": { "id": { "type": "string" }, "category": { "type": "string", "enum": ["announcement", "judicial_or_administrative", "news", "reputation"] }, "claimKind": { "type": "string", "enum": ["fact", "opinion"] }, "occurredAt": { "type": "string", "format": "date-time" }, "title": { "type": "string" }, "summary": { "type": "string" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "dataQuality": { "$ref": "#/$defs/dataQuality" } } },
    "observation": { "type": "object", "additionalProperties": false, "required": ["id", "category", "claimKind", "statement", "evidenceIds", "dataQuality"], "properties": { "id": { "type": "string" }, "category": { "type": "string", "enum": ["company_profile", "news", "reputation", "operations"] }, "claimKind": { "type": "string", "enum": ["fact", "opinion"] }, "statement": { "type": "string" }, "stance": { "type": "string", "enum": ["positive", "neutral", "negative", "unknown"] }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "dataQuality": { "$ref": "#/$defs/dataQuality" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "category", "claimKind", "sourceName", "sourceUrl", "retrievedAt", "title", "provenance", "extraction"], "properties": { "id": { "type": "string" }, "category": { "type": "string", "enum": ["financial_statement", "exchange_announcement", "judicial_or_administrative", "news", "company_profile", "reputation"] }, "claimKind": { "type": "string", "enum": ["fact", "opinion"] }, "sourceName": { "type": "string" }, "sourceUrl": { "type": "string", "format": "uri" }, "retrievedAt": { "type": "string", "format": "date-time" }, "publishedAt": { "type": "string", "format": "date-time" }, "title": { "type": "string" }, "excerpt": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" }, "extraction": { "$ref": "#/$defs/extraction" } }, "allOf": [{ "if": { "properties": { "provenance": { "properties": { "sourceType": { "const": "social_platform" } }, "required": ["sourceType"] } } }, "then": { "properties": { "claimKind": { "const": "opinion" }, "provenance": { "properties": { "reliabilityTier": { "const": "community" } }, "required": ["reliabilityTier"] } } } }] },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["sourceType", "accessMethod", "adapterId", "reliabilityTier"], "properties": { "sourceType": { "type": "string", "enum": ["official_api", "official_web", "open_data", "web_page", "social_platform"] }, "accessMethod": { "type": "string", "enum": ["structured_api", "html_parser", "open_source_tool", "llm_assisted", "manual_import"] }, "adapterId": { "type": "string" }, "reliabilityTier": { "type": "string", "enum": ["official", "third_party", "community"] }, "contentHash": { "type": "string" } } },
    "extraction": { "type": "object", "additionalProperties": false, "required": ["method", "verificationStatus"], "properties": { "method": { "type": "string", "enum": ["structured_api", "html_parser", "open_source_tool", "llm_assisted", "manual_import"] }, "extractionConfidence": { "type": "number", "minimum": 0, "maximum": 1 }, "verificationStatus": { "type": "string", "enum": ["verified", "unverified", "rejected"] } }, "allOf": [{ "if": { "properties": { "method": { "const": "llm_assisted" } }, "required": ["method"] }, "then": { "required": ["extractionConfidence"] } }] },
    "dataQuality": { "type": "object", "additionalProperties": false, "required": ["verificationStatus", "conflictStatus", "scoreEligible"], "properties": { "verificationStatus": { "type": "string", "enum": ["verified", "unverified", "rejected"] }, "conflictStatus": { "type": "string", "enum": ["resolved", "conflicted", "not_applicable"] }, "scoreEligible": { "type": "boolean" }, "resolutionReason": { "type": "string" } }, "allOf": [{ "if": { "properties": { "verificationStatus": { "enum": ["unverified", "rejected"] } }, "required": ["verificationStatus"] }, "then": { "properties": { "scoreEligible": { "const": false } } } }, { "if": { "properties": { "conflictStatus": { "const": "conflicted" } }, "required": ["conflictStatus"] }, "then": { "properties": { "scoreEligible": { "const": false } }, "required": ["resolutionReason"] } }] },
    "decision": { "type": "object", "additionalProperties": false, "required": ["fieldKey", "status", "evidenceIds", "reason"], "properties": { "fieldKey": { "type": "string" }, "status": { "type": "string", "enum": ["adopted", "conflicted", "rejected"] }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "reason": { "type": "string" } } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["dimension", "status", "retrievedAt"], "properties": { "dimension": { "type": "string", "enum": ["financial_health", "debt_credit", "operations_reputation"] }, "status": { "type": "string", "enum": ["complete", "partial", "unavailable"] }, "reason": { "type": "string" }, "retrievedAt": { "type": "string", "format": "date-time" }, "sourceNames": { "type": "array", "items": { "type": "string" } } }, "allOf": [{ "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] }, "then": { "required": ["reason"] } }] },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string", "enum": ["company_not_found", "ambiguous_company", "source_unavailable", "source_timeout", "rate_limited", "invalid_data"] }, "message": { "type": "string" }, "sourceId": { "type": "string" }, "dimension": { "type": "string" }, "retryable": { "type": "boolean" } } }
  }
}
