{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/contracts/llm-narrative-request.v1.schema.json",
  "title": "LlmNarrativeRequest v1", "x-contract-status": "frozen", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "language", "assessment", "evidencePack", "sections"],
  "properties": {
    "schemaVersion": { "const": "v1" }, "requestId": { "type": "string" }, "language": { "const": "zh-CN" },
    "assessment": { "$ref": "#/$defs/assessment" }, "evidencePack": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceExcerpt" } },
    "sections": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["overall_summary", "financial_explanation", "risk_explanation", "reputation_explanation"] } }
  },
  "$defs": {
    "assessment": { "type": "object", "additionalProperties": false, "required": ["riskLevel", "signals"], "properties": { "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "unknown"] }, "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } } } },
    "signal": { "type": "object", "additionalProperties": false, "required": ["id", "severity", "title", "explanation", "evidenceIds"], "properties": { "id": { "type": "string" }, "severity": { "type": "string", "enum": ["positive", "info", "warning", "critical"] }, "title": { "type": "string" }, "explanation": { "type": "string" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "evidenceExcerpt": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "claimKind", "sourceType", "reliabilityTier", "verificationStatus", "publishedOrRetrievedAt", "excerpt"], "properties": { "evidenceId": { "type": "string" }, "claimKind": { "type": "string", "enum": ["fact", "opinion"] }, "sourceType": { "type": "string", "enum": ["official_api", "official_web", "open_data", "web_page", "social_platform"] }, "reliabilityTier": { "type": "string", "enum": ["official", "third_party", "community"] }, "verificationStatus": { "type": "string", "enum": ["verified", "unverified"] }, "publishedOrRetrievedAt": { "type": "string", "format": "date-time" }, "excerpt": { "type": "string", "maxLength": 3000 } } }
  }
}
