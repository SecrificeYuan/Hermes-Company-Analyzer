# ===== 数据源引擎可选配置（不配置则自动降级到 mock，UI 不受影响）=====

# 聚合数据涉诉接口 key（https://www.juhe.cn 免费注册）
JUHE_API_KEY=

# 巨潮公告抓取开关（true 启用，默认关闭）
CNINFO_ENABLED=false

# GDELT 舆情接口开关（true 启用，默认关闭）
GDELT_ENABLED=false

# 站点基础地址（生产部署时用于前端 fetch，本地开发无需配置）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===== LLM 对话管线（OpenAI 兼容网关；不配置则回退模板话术）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
